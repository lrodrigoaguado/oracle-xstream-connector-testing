{
  "name": "JdbcSinkConnectorConnector_0",
  "config": {
    "name": "JdbcSinkConnectorConnector_0",
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "4",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "errors.retry.timeout": "10000",
    "errors.retry.delay.max.ms": "2000",
    "errors.tolerance": "all",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true",
    "topics": "xstream.C__CFLTUSER.EMPLOYEES,xstream.C__CFLTUSER.DATA_TYPES_TEST,xstream.C__CFLTUSER.DEPARTMENTS,xstream.C__CFLTUSER.JOBS,xstream.C__CFLTUSER.CUSTOMERS,xstream.C__CFLTUSER.ORDERS",
    "max.retries": "30",
    "retry.backoff.ms": "2000",
    "errors.deadletterqueue.topic.name": "SINK_DLQ",
    "errors.deadletterqueue.context.headers.enable": "true",
    "connection.url": "jdbc:postgresql://postgres:5432/test-connector",
    "connection.user": "test-connector",
    "connection.password": "test-connector",
    "dialect.name": "PostgreSqlDatabaseDialect",
    "insert.mode": "upsert",
    "delete.enabled": "true",
    "batch.size": "1",
    "auto.create": "true",
    "auto.evolve": "true",
    "transforms": "routeTopic",
    "transforms.routeTopic.regex": "(.*)\\.C__CFLTUSER\\.(.*)",
    "transforms.routeTopic.replacement": "$2",
    "transforms.routeTopic.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "pk.mode": "record_key"
  }
}