{
    "name": "OracleXStreamSourceConnector",
    "config": {
        "name": "OracleXStreamSourceConnector",
        "connector.class": "io.confluent.connect.oracle.xstream.cdc.OracleXStreamSourceConnector",
        "tasks.max": "1",

        "key.converter": "io.confluent.connect.avro.AvroConverter",
        "key.converter.schema.registry.url": "http://schema-registry:8081",
        "value.converter": "io.confluent.connect.avro.AvroConverter",
        "value.converter.schema.registry.url": "http://schema-registry:8081",

        "database.hostname": "oracle-xe",
        "database.port": "1521",
        "database.user": "c##cfltuser",
        "database.password": "My_RandomPass192837465",
        "database.dbname": "XE",
        "database.service.name": "XE",
        "database.pdb.name": "XEPDB1",
        "database.out.server.name": "XOUT",
        "database.processor.licenses": "1",

        "topic.prefix": "xstream",
        "table.include.list": "DEMO[.].*",
        "message.key.columns": "DEMO.JOBS:JOB_ID;",
        "skipped.operations": "none",

        "snapshot.mode": "initial",
        "snapshot.fetch.size": 10000,
        "snapshot.max.threads": 4,

        "query.fetch.size": 10000,
        "max.queue.size": 65536,
        "max.batch.size": 16384,
        "producer.override.batch.size": 204800,
        "producer.override.linger.ms": 50,
        "heartbeat.interval.ms": 300000,
        "enable.metrics.collection": "true",

        "decimal.handling.mode": "double",
        "time.precision.mode": "connect",
        "binary.handling.mode": "bytes",

        "lob.enabled": "true",
        "lob.oversize.threshold": "-1",
        "lob.oversize.handling.mode": "fail",
        "unavailable.value.placeholder": "__cflt_unavailable_value",

        "schema.history.internal.kafka.topic": "oracle_schema_history",
        "schema.history.internal.kafka.bootstrap.servers": "broker1:29092,broker2:29092,broker3:29092",
        "schema.history.internal.skip.unparseable.ddl": "true",
        "schema.history.internal.store.only.captured.tables.ddl": "true",

        "transforms": "flatten,convertTS",
        "transforms.flatten.type": "io.debezium.transforms.ExtractNewRecordState",
        "transforms.flatten.drop.tombstones": "false",
        "transforms.flatten.delete.handling.mode": "none",
        "transforms.flatten.delete.tombstone.handling.mode": "tombstone",
        "transforms.flatten.add.fields": "source.ts_ms:SOURCETIMESTAMP,source.db:MAQUINA_ID",
        "transforms.flatten.add.fields.prefix": "",
        "transforms.convertTS.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
        "transforms.convertTS.target.type": "Timestamp",
        "transforms.convertTS.field": "SOURCETIMESTAMP",

        "errors.log.enable": "true",
        "errors.log.include.messages": "true"
    }
}
